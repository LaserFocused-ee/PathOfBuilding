+-- The page writes back only the build it loaded. Every other Init of the build module (Back then New,
+-- opening a saved build, importing a new build in the view) clears the mark, and getBuildCode then
+-- returns "!not-loaded" instead of exporting another build (a Lua error reaches the page only as
+-- "getBuildCode failed"; "!" never occurs in a build code).
+local function markLoadedBuilds(build)
+    if build.viewInitMarked then
+        return
+    end
+    local init = build.Init
+    build.Init = function(self, ...)
+        self.viewLoaded = false
+        return init(self, ...)
+    end
+    build.viewInitMarked = true
+end
+
