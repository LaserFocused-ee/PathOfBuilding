{
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/http": "jsr:@std/http@1.0.25",
    "@std/path": "jsr:@std/path@1.1.6"
  },
  "exclude": [
    ".build",
    "dist",
    "src/vite.config.ts"
  ],
  "fmt": {
    "lineWidth": 120
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check tools src/sync.ts src/api.ts src/content.ts src/links.ts && deno test --allow-read tools src"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "es2022"
    ]
  }
}
