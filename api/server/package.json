{
  "name": "pob-api-server",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API and MCP server over the Path of Building engine: worker pool, build store, routes, MCP tools",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pob-api-mcp": "dist/src/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-timeout=60000 \"dist/test/*.test.js\"",
    "docs": "node dist/src/gen-api-doc.js ..",
    "start": "node dist/src/index.js",
    "mcp": "node dist/src/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@sentry/node": "11.12.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "peerDependencies": {
    "@sentry/node": "11.12.0"
  },
  "peerDependenciesMeta": {
    "@sentry/node": {
      "optional": true
    }
  }
}
